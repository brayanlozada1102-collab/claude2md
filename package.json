{
  "name": "claude2md",
  "version": "1.0.0",
  "description": "CLI tool to parse Claude exported conversations to optimized Markdown for LLM context",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "claude2md": "./dist/index.js"
  },
  "scripts": {
